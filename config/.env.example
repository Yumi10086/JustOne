# JustOne 环境配置示例
# 复制此文件为 .env 后修改配置

# ==================== 通用配置 ====================
# 开启版本检查
ENABLE_CHECK_VERSION=true
# 结果保存格式，可选 "csv" 或 "json"
RESULT_SAVE_FORMAT=csv
# 只导出存活的子域
RESULT_EXPORT_ALIVE=false

# ==================== HTTP 配置 ====================
# 请求超时时间（秒）
HTTP_TIMEOUT=15
# SSL 证书验证（生产环境建议开启）
HTTP_VERIFY_SSL=false
# 允许重定向
HTTP_ALLOW_REDIRECT=true
# 使用随机 User-Agent
HTTP_ENABLE_RANDOM_UA=true
# 请求线程数（默认空则自动设置）
HTTP_THREAD_COUNT=
# 最大重定向次数
HTTP_REDIRECT_LIMIT=10

# ==================== 代理配置 ====================
# 是否启用代理
PROXY_ENABLE=false

# ==================== 暴力破解模块配置 ====================
# 启用暴力破解模块
BRUTE_ENABLE=true
# 并发数量（最大推荐 10000）
BRUTE_CONCURRENT=2000
# 启用递归爆破
BRUTE_RECURSIVE=false
# 递归爆破深度
BRUTE_RECURSIVE_DEPTH=2
# 开启泛解析检测
BRUTE_WILDCARD_CHECK=true
# 开启泛解析处理
BRUTE_WILDCARD_DEAL=true

# ==================== 信息收集模块配置 ====================
# 启用信息收集模块
COLLECT_ENABLE=true
# 每个收集模块超时时间（秒）
COLLECT_MODULE_TIMEOUT=120
# 最大并发数
COLLECT_MAX_CONCURRENT=50

# ==================== DNS 解析配置 ====================
# 启用 DNS 解析
DNS_ENABLE=true
# DNS_NAMESERVERS已固定

# ==================== 端口探测配置 ====================
# 启用端口探测
PORTSCAN_ENABLE=true
# 端口范围模式：small / medium / large
PORTSCAN_MODE=small

# ==================== 搜索模块配置 ====================
# 启用搜索模块
SEARCH_ENABLE=true
# 启用全量搜索（获取全部结果，可能耗时较长）
SEARCH_ENABLE_FULL_SEARCH=false
# 启用递归搜索
SEARCH_ENABLE_RECURSIVE_SEARCH=false
# 递归搜索层数
SEARCH_RECURSIVE_TIMES=2

# ==================== 其他模块配置 ====================
CERTIFICATE_ENABLE=true
DATASETS_ENABLE=true
INTELLIGENCE_ENABLE=true
FINGERPRINT_ENABLE=true
TAKEOVER_ENABLE=false
EXPORT_ENABLE=true

# ==================== API 凭证配置 ====================
# Censys: https://censys.io/api
CENSYS_API_ID=
CENSYS_API_SECRET=

# Binaryedge: https://app.binaryedge.io/account/api
BINARYEDGE_API=

# FOFA: https://fofa.so/api
FOFA_EMAIL=
FOFA_API_KEY=

# Shodan: https://account.shodan.io/register
SHODAN_API_KEY=

# VirusTotal: https://developers.virustotal.com/reference
VIRUSTOTAL_API_KEY=

# ZoomEye: https://www.zoomeye.org/doc?channel=api
ZOOMEYE_EMAIL=
ZOOMEYE_PASSWORD=

# GitHub: https://github.com/settings/tokens
GITHUB_API_USER=
GITHUB_TOKEN=

# Hunter: https://hunter.qianxin.com/home/userInfo
HUNTER_API_KEY=

# 360 Quake: https://quake.360.cn/
QUAKE_API_KEY=