# JustOne 环境配置示例
# 复制此文件为 .env 后修改配置

# ==================== 通用配置 ====================
ENABLE_CHECK_VERSION=true
RESULT_SAVE_FORMAT=csv
RESULT_EXPORT_ALIVE=false

# ==================== HTTP 配置 ====================
HTTP_TIMEOUT=15
HTTP_VERIFY_SSL=false
HTTP_ALLOW_REDIRECT=true
HTTP_ENABLE_RANDOM_UA=true
HTTP_THREAD_COUNT=
HTTP_REDIRECT_LIMIT=10

# ==================== 代理配置 ====================
PROXY_ENABLE=false
PROXY_POOL=

# ==================== 暴力破解模块配置 ====================
BRUTE_ENABLE=true
BRUTE_CONCURRENT=2000
BRUTE_RECURSIVE=false
BRUTE_RECURSIVE_DEPTH=2
BRUTE_WILDCARD_CHECK=true
BRUTE_WILDCARD_DEAL=true

# ==================== 信息收集模块配置 ====================
COLLECT_ENABLE=true
COLLECT_MODULE_TIMEOUT=120
COLLECT_MAX_CONCURRENT=50

# ==================== DNS / 端口 / 搜索 / 其他 ====================
DNS_ENABLE=true
PORTSCAN_ENABLE=true
PORTSCAN_MODE=small
SEARCH_ENABLE=true
SEARCH_ENABLE_FULL_SEARCH=false
SEARCH_ENABLE_RECURSIVE_SEARCH=false
SEARCH_RECURSIVE_TIMES=2
CERTIFICATE_ENABLE=true
DATASETS_ENABLE=true
INTELLIGENCE_ENABLE=true
FINGERPRINT_ENABLE=true
TAKEOVER_ENABLE=false
EXPORT_ENABLE=true

# ==================== API 凭证配置 ====================

# Censys: https://censys.io/api
CENSYS_API_ID=
CENSYS_API_SECRET=
CENSYS_API_TOKEN=

# Chinaz: http://api.chinaz.com/ApiDetails/Alexa
CHINAZ_API=

# SecurityTrails: https://securitytrails.com/corp/api
SECURITYTRAILS_API=

# FOFA: https://fofa.so/api
FOFA_EMAIL=
FOFA_API_KEY=

# Shodan: https://account.shodan.io/register
SHODAN_API_KEY=

# ZoomEye: https://www.zoomeye.org/doc?channel=api
ZOOMEYE_API=

# CIRCL: https://www.circl.lu/services/passive-dns/
CIRCL_USERNAME=
CIRCL_PASSWORD=

# GitHub: https://github.com/settings/tokens
GITHUB_API_USER=
GITHUB_TOKEN=

# Cloudflare: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Hunter (奇安信鹰图): https://hunter.qianxin.com/home/userInfo
HUNTER_API_KEY=

# FullHunt: https://api-docs.fullhunt.io/
FULLHUNT_API_KEY=

# DNSDumpster: https://dnsdumpster.com/developer/
DNSDUMPSTER_API_KEY=

# LeakIX: https://leakix.net/settings/api
LEAKIX_API=

# AlienVault OTX: https://otx.alienvault.com/settings/api
ALIENVAULT_API_KEY=

# URLScan: https://urlscan.io/user/profile/
URLSCAN_API_KEY=

# ThreatBook (微步在线): https://x.threatbook.com/v5/myApi
THREATBOOK_API_KEY=

# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# VirusTotal 分页间隔（秒），免费版 4 req/min 建议 ≥15，付费 API 可设 1-2
VIRUSTOTAL_PAGE_DELAY=16

# VirusTotal 最大页数（每页 40 条，50 页 ≈ 2000 条），设置上限防止超时
VIRUSTOTAL_MAX_PAGES=20
