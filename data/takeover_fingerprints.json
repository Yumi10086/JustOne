{
  "aws-s3": {
    "name": "AWS S3",
    "severity": "high",
    "cname_match": "regex",
    "cname": ["\\.s3\\.amazonaws\\.com$", "\\.s3-website[-\\.]"],
    "ns_takeover": false,
    "http_check": {
      "enabled": true,
      "method": "GET",
      "paths": ["/"],
      "fingerprints": [
        {"type": "body", "pattern": "NoSuchBucket", "required": true},
        {"type": "header", "pattern": "x-amz-request-id", "required": false}
      ],
      "status_codes": [404, 403]
    }
  },
  "github-pages": {
    "name": "GitHub Pages",
    "severity": "high",
    "cname_match": "suffix",
    "cname": [".github.io"],
    "ns_takeover": false,
    "http_check": {
      "enabled": true,
      "method": "GET",
      "paths": ["/"],
      "fingerprints": [
        {"type": "body", "pattern": "There isn't a GitHub Pages site here", "required": true}
      ],
      "status_codes": [404]
    }
  },
  "heroku": {
